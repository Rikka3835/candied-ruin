{
  "name": "candied-ruin",
  "version": "0.1.0",
  "private": true,
  "description": "《糖渍旧蜜》CANDIED RUIN — 轻小说站点（静态页 + 章节构建）",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-chapters.mjs && node scripts/build-pages.mjs",
